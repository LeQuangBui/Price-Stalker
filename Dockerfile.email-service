FROM eclipse-temurin:25-jdk AS build
WORKDIR /workspace

COPY price-stalker-core ./price-stalker-core
COPY email-service ./email-service

RUN chmod +x price-stalker-core/mvnw email-service/mvnw
RUN cd price-stalker-core && ./mvnw -B install -DskipTests
RUN cd email-service && ./mvnw -B package -DskipTests

FROM eclipse-temurin:25-jre
WORKDIR /app

COPY --from=build /workspace/email-service/target/*.jar /app/app.jar

EXPOSE 8081
ENTRYPOINT ["java", "-jar", "/app/app.jar"]