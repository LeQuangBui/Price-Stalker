# Edge reverse proxy for the price-stalker VPS stack.
#
# DOMAIN is injected from .env.prod via the caddy service:
#   - a real hostname (price-stalker.example.com) => automatic Let's Encrypt HTTPS
#   - ":80" => plain HTTP, useful when pointing at a bare IP during setup
#
# WWW_DOMAIN is the optional www alias. Set it to www.<your domain> to get a redirect to the
# apex; leave it unset and it defaults to localhost, which Caddy serves with an internal cert
# and never takes to Let's Encrypt — so the bare-IP and no-www setups stay unaffected.
#
# Routing:
#   /api/*  -> api:8080   (the /api prefix is stripped before proxying)
#   /*      -> frontend:80 (static SPA + /healthz)

{$DOMAIN} {
	encode gzip

	header {
		# Defense-in-depth security headers at the TLS edge — applied to BOTH the API and the SPA.
		# HSTS is ignored by browsers over plain HTTP, so it stays safe in the ":80" testing mode.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	handle_path /api/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy frontend:80
	}
}

# Send www to the apex. A redirect rather than a second copy of the site: CORS_ALLOWED_ORIGIN and
# the SPA's baked API URL are both the apex, so serving www directly would fail every API call.
{$WWW_DOMAIN:localhost} {
	header Strict-Transport-Security "max-age=31536000"
	redir https://{$DOMAIN}{uri} permanent
}
