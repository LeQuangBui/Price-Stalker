# RabbitMQ
RABBITMQ_URL=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# PROXY
PROXY_URL=

# AWS S3 / S3-compatible object storage (AWS, MEGA S4, DigitalOcean Spaces)
AWS_REGION=
# S3-compatible endpoint. Leave blank for real AWS S3. MEGA S4 e.g. https://s3.ap-tokyo.megas4.com
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_IMAGES_FOLDER_URI=
AWS_IMAGES_FOLDER_URL=
AWS_KEY_PREFIX=
LOCAL_TEMP_FOLDER=
