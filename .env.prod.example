# Production environment for docker-compose.prod.yml.
# Copy to .env.prod ON THE VPS and fill in real values. Never commit .env.prod.
#
#   cp .env.prod.example .env.prod && nano .env.prod

# ---- Public address -------------------------------------------------------
# Full origin the app is served on. Drives CORS, email links, and the SPA's API URL.
PUBLIC_BASE_URL=https://price-stalker.example.com

# Caddy site address. Use the same hostname as above for automatic HTTPS,
# or ":80" to serve plain HTTP against a bare IP while you set DNS up.
DOMAIN=price-stalker.example.com
# Optional www alias, permanently redirected to the apex. Needs its own A record. Leave blank
# to skip it entirely — Caddy then binds localhost instead and never requests a www certificate.
WWW_DOMAIN=www.price-stalker.example.com

# ---- Database -------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_DATABASE=price_stalker

# ---- RabbitMQ -------------------------------------------------------------
RABBITMQ_USER=pricestalker
RABBITMQ_PASSWORD=change-me-strong-password

# ---- Auth -----------------------------------------------------------------
# Long random string (>= 64 chars). Generate: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_EXPIRATION=86400000

# ---- Email (email-service) ------------------------------------------------
# Only 'resend' is deployable — the self-hosted Postfix MTA behind 'smtp' was removed.
MAIL_PROVIDER=resend
MAIL_FROM=alerts@price-stalker.example.com
# NOTE: in a send-only setup this mailbox does not exist, so replies bounce. Point it at a
# real/forwarding mailbox or accept bouncing replies knowingly.
MAIL_REPLY_TO=support@price-stalker.example.com
# Required: email-service refuses to start without it. Get one from the Resend dashboard, and
# verify the sending domain there too — Resend will not send from an unverified domain.
RESEND_API_KEY=change-me-resend-api-key
RESEND_BASE_URL=https://api.resend.com

# ---- Web Push / VAPID (E4; all optional — leave blank to disable push) ----
# Generate ONCE with: npx web-push generate-vapid-keys  (see SETUP-AND-DEPLOY.md).
# PUBLIC + PRIVATE must be a matched pair. The public key is baked into every browser
# subscription, so rotating it forces every user to re-subscribe — treat as permanent.
# Blank values disable push end-to-end: the SPA hides the toggle and the email-service
# listeners no-op (both services still boot).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the push service can reach if your sender misbehaves (mailto: or https:).
VAPID_SUBJECT=mailto:admin@price-stalker.example.com

# ---- Crawler (all optional; leave blank to disable) -----------------------
PROXY_URL=
# S3-compatible image storage (MEGA S4, DigitalOcean Spaces, AWS S3). Optional.
AWS_REGION=
# Endpoint for a non-AWS S3-compatible provider (MEGA S4 e.g. https://s3.ap-tokyo.megas4.com).
# Leave blank for real AWS S3. REQUIRED for MEGA S4 — without it uploads go to AWS instead.
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_IMAGES_FOLDER_URI=
AWS_IMAGES_FOLDER_URL=
AWS_KEY_PREFIX=
LOCAL_TEMP_FOLDER=/tmp/crawler
