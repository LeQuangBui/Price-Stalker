FROM eclipse-temurin:25-jdk AS build
WORKDIR /workspace

COPY price-stalker-core ./price-stalker-core
COPY cron-service ./cron-service

RUN chmod +x price-stalker-core/mvnw cron-service/mvnw
RUN cd price-stalker-core && ./mvnw -B install -DskipTests
RUN cd cron-service && ./mvnw -B package -DskipTests

FROM eclipse-temurin:25-jre
WORKDIR /app

COPY --from=build /workspace/cron-service/target/*.jar /app/app.jar

EXPOSE 8082
ENTRYPOINT ["java", "-jar", "/app/app.jar"]