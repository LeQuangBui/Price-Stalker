FROM eclipse-temurin:25-jdk AS build
WORKDIR /workspace

COPY price-stalker-core ./price-stalker-core
COPY api ./api

RUN chmod +x price-stalker-core/mvnw api/mvnw
RUN cd price-stalker-core && ./mvnw -B install -DskipTests
RUN cd api && ./mvnw -B package -DskipTests

FROM eclipse-temurin:25-jre
WORKDIR /app

COPY --from=build /workspace/api/target/*.jar /app/app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
